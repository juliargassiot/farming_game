{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash tools/setup_env.sh", "timeout": 600 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 tools/hooks/comment_density_hook.py post" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 tools/hooks/comment_density_hook.py stop" }
        ]
      }
    ]
  }
}
